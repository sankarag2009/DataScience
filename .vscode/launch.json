{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SilicoBioScreen API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload"
      ]
    },
    {
      "name": "SilicoBioScreen UI",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "ui.py"
      ]
    }
  ]
}